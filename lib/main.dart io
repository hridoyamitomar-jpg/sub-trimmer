  // ---------- লোকাল স্টোরেজ থেকে ডেটা লোড করা ----------
  Future<void> _loadSubscriptions() async {
    _prefs = await SharedPreferences.getInstance();
    final String? savedData = _prefs.getString(_storageKey);

    List<Subscription> loaded;
    if (savedData == null || savedData.isEmpty) {
      // প্রথমবার অ্যাপ চালু হলে ডেমো ডেটা দেখানো হবে
      loaded = _defaultSubscriptions();
    } else {
      try {
        final List<dynamic> decoded = jsonDecode(savedData);
        loaded = decoded
            .map((item) => Subscription.fromJson(item as Map<String, dynamic>))
            .toList();
      } catch (_) {
        // ডেটা করাপ্টেড হলে ডেমো ডেটায় ফিরে যাওয়া
        loaded = _defaultSubscriptions();
      }
    }

    setState(() {
      _subscriptions = loaded;
      _isLoading = false;
    });
  }

  // ---------- লোকাল স্টোরেজে ডেটা সেভ করা ----------
  Future<void> _saveSubscriptions() async {
    final String encoded =
        jsonEncode(_subscriptions.map((s) => s.toJson()).toList());
    await _prefs.setString(_storageKey, encoded);
  }

  // বার্ষিক সাবস্ক্রিপশনকে মাসিক হিসেবে ভেঙে মোট বের করা হয়
  double get _totalMonthlyCost => _subscriptions.fold(
      0, (sum, item) => sum + item.monthlyEquivalentCost);

  double get _totalYearlyCost => _totalMonthlyCost * 12;

  List<Subscription> get _unusedSubscriptions =>
      _subscriptions.where((s) => s.isUnused).toList();

  void _addSubscription(Subscription sub) {
    setState(() {
      _subscriptions.add(sub);
    });
    _saveSubscriptions();
  }

  void _deleteSubscription(int index) {
    setState(() {
      _subscriptions.removeAt(index);
    });
    _saveSubscriptions();
  }

  void _cancelSubscription(Subscription sub) {
    setState(() {
      _subscriptions.remove(sub);
    });
    _saveSubscriptions();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('${sub.name} বাতিল করা হয়েছে')),
    );
  }

  void _markAsUsed(Subscription sub) {
    setState(() {
      sub.lastUsedDate = DateTime.now();
    });
    _saveSubscriptions();
  }

