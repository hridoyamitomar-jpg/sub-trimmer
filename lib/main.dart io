              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text(
                  '৳${sub.cost.toStringAsFixed(0)}',
                  style: const TextStyle(
                    fontSize: 15,
                    fontWeight: FontWeight.bold,
                    color: Color(0xFF6C5CE7),
                  ),
                ),
                if (sub.billingCycle == BillingCycle.yearly)
                  Text(
                    '≈৳${sub.monthlyEquivalentCost.toStringAsFixed(0)}/মাস',
                    style: const TextStyle(fontSize: 10, color: Colors.grey),
                  ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  String _formatDate(DateTime date) {
    const months = [
      'জানু',
      'ফেব্রু',
      'মার্চ',
      'এপ্রিল',
      'মে',
      'জুন',
      'জুলাই',
      'আগস্ট',
      'সেপ্টে',
      'অক্টো',
      'নভে',
      'ডিসে'
    ];
    return '${date.day} ${months[date.month - 1]}';
  }
}

// ---------------- ADD SUBSCRIPTION SHEET ----------------
class AddSubscriptionSheet extends StatefulWidget {
  final void Function(Subscription) onAdd;
  const AddSubscriptionSheet({super.key, required this.onAdd});

  @override
  State<AddSubscriptionSheet> createState() => _AddSubscriptionSheetState();
}

class _AddSubscriptionSheetState extends State<AddSubscriptionSheet> {
  final _nameController = TextEditingController();
  final _costController = TextEditingController();
  DateTime _selectedDate = DateTime.now().add(const Duration(days: 30));

  final List<Map<String, dynamic>> _iconOptions = [
    {'icon': Icons.smart_display_rounded, 'color': const Color(0xFFE50914)},
    {'icon': Icons.music_note_rounded, 'color': const Color(0xFF1DB954)},
    {'icon': Icons.wifi_rounded, 'color': const Color(0xFF0984E3)},
    {'icon': Icons.fitness_center_rounded, 'color': const Color(0xFFE17055)},
    {'icon': Icons.cloud_rounded, 'color': const Color(0xFF00B894)},
    {'icon': Icons.games_rounded, 'color': const Color(0xFF6C5CE7)},
  ];
  int _selectedIconIndex = 0;
  BillingCycle _billingCycle = BillingCycle.monthly;
  DateTime _lastUsedDate = DateTime.now();

  Future<void> _pickDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: _selectedDate,
      firstDate: DateTime.now(),
      lastDate: DateTime(2030),
      builder: (context, child) => Theme(
        data: Theme.of(context).copyWith(
          colorScheme: const ColorScheme.light(primary: Color(0xFF6C5CE7)),
        ),
        child: child!,
      ),
    );
    if (picked != null) {
      setState(() => _selectedDate = picked);
    }
  }

  Future<void> _pickLastUsedDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: _lastUsedDate,
      firstDate: DateTime(2020),
      lastDate: DateTime.now(),
      builder: (context, child) => Theme(
        data: Theme.of(context).copyWith(
          colorScheme: const ColorScheme.light(primary: Color(0xFF6C5CE7)),
        ),
        child: child!,
      ),
    );
    if (picked != null) {
      setState(() => _lastUsedDate = picked);
    }
  }

  void _submit() {
    final name = _nameController.text.trim();
    final cost = double.tryParse(_costController.text.trim());
    if (name.isEmpty || cost == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('সঠিক নাম ও খরচ দিন')),
      );
      return;
    }
    widget.onAdd(
      Subscription(
        name: name,
        cost: cost,
        renewalDate: _selectedDate,
        icon: _iconOptions[_selectedIconIndex]['icon'],
        color: _iconOptions[_selectedIconIndex]['color'],
        billingCycle: _billingCycle,
        lastUsedDate: _lastUsedDate,
      ),
    );
    Navigator.pop(context);
  }

  Widget _cycleOption({
    required String label,
    required IconData icon,
    required BillingCycle cycle,
  }) {
    final selected = _billingCycle == cycle;
    return GestureDetector(
      onTap: () => setState(() => _billingCycle = cycle),
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 14),
        decoration: BoxDecoration(
          color:
              selected ? const Color(0xFF6C5CE7).withOpacity(0.12) : Colors.grey.shade100,
          borderRadius: BorderRadius.circular(14),
          border: selected
              ? Border.all(color: const Color(0xFF6C5CE7), width: 1.5)
              : null,
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              icon,
              size: 18,
              color: selected ? const Color(0xFF6C5CE7) : Colors.grey,
            ),
            const SizedBox(width: 8),
            Text(
              label,
              style: TextStyle(
                fontSize: 14,
                fontWeight: selected ? FontWeight.w700 : FontWeight.w500,
                color: selected ? const Color(0xFF6C5CE7) : Colors.grey.shade700,
              ),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: EdgeInsets.only(
        bottom: MediaQuery.of(context).viewInsets.bottom,
      ),
      child: Container(
        decoration: const BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
        ),
        padding: const EdgeInsets.fromLTRB(24, 16, 24, 24),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Center(
              child: Container(
                width: 40,
                height: 4,
                decoration: BoxDecoration(
                  color: Colors.grey.shade300,
                  borderRadius: BorderRadius.circular(10),
                ),
              ),
            ),
            const SizedBox(height: 18),
            const Text(
              'নতুন সাবস্ক্রিপশন যোগ করুন',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 18),

            // Icon picker
            SizedBox(
              height: 56,
              child: ListView.separated(
                scrollDirection: Axis.horizontal,
                itemCount: _iconOptions.length,
                separatorBuilder: (_, __) => const SizedBox(width: 10),
                itemBuilder: (context, index) {
                  final selected = _selectedIconIndex == index;
                  final opt = _iconOptions[index];
                  return GestureDetector(
                    onTap: () => setState(() => _selectedIconIndex = index),
                    child: Container(
                      width: 50,
                      height: 50,
                      decoration: BoxDecoration(
                        color: selected
                            ? opt['color'].withOpacity(0.15)
                            : Colors.grey.shade100,
                        borderRadius: BorderRadius.circular(14),
                        border: selected
                            ? Border.all(color: opt['color'], width: 2)
                            : null,
                      ),
                      child: Icon(opt['icon'], color: opt['color']),
                    ),
                  );
                },
              ),
            ),
            const SizedBox(height: 18),

            TextField(
              controller: _nameController,
              decoration: InputDecoration(
                labelText: 'সাবস্ক্রিপশনের নাম',
                hintText: 'যেমন: Netflix',
                filled: true,
                fillColor: Colors.grey.shade100,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(14),
