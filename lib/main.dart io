// ---------------- MODEL ----------------
enum BillingCycle { monthly, yearly }

extension BillingCycleLabel on BillingCycle {
  String get label => this == BillingCycle.monthly ? 'মাসিক' : 'বার্ষিক';
}

class Subscription {
  final String name;
  final double cost;
  final DateTime renewalDate;
  final IconData icon;
  final Color color;
  final BillingCycle billingCycle;
  DateTime lastUsedDate;

  Subscription({
    required this.name,
    required this.cost,
    required this.renewalDate,
    required this.icon,
    required this.color,
    this.billingCycle = BillingCycle.monthly,
    DateTime? lastUsedDate,
  }) : lastUsedDate = lastUsedDate ?? DateTime.now();

  // মাসিক হিসেবে খরচ (বার্ষিক হলে ভাগ করে দেখানো হয়)
  double get monthlyEquivalentCost =>
      billingCycle == BillingCycle.yearly ? cost / 12 : cost;

  // বার্ষিক হিসেবে খরচ (মাসিক হলে গুণ করে দেখানো হয়)
  double get yearlyEquivalentCost =>
      billingCycle == BillingCycle.yearly ? cost : cost * 12;

  int get daysSinceLastUsed => DateTime.now().difference(lastUsedDate).inDays;

  // গত ৩০ দিনে ব্যবহার না হলে "অপ্রয়োজনীয়" হিসেবে চিহ্নিত হবে
  bool get isUnused => daysSinceLastUsed > 30;

  // ---------- লোকাল স্টোরেজের জন্য JSON কনভার্শন ----------
  Map<String, dynamic> toJson() => {
        'name': name,
        'cost': cost,
        'renewalDate': renewalDate.toIso8601String(),
        'iconCodePoint': icon.codePoint,
        'iconFontFamily': icon.fontFamily,
        'colorValue': color.value,
        'billingCycle': billingCycle.name,
        'lastUsedDate': lastUsedDate.toIso8601String(),
      };

  factory Subscription.fromJson(Map<String, dynamic> json) {
    return Subscription(
      name: json['name'] as String,
      cost: (json['cost'] as num).toDouble(),
      renewalDate: DateTime.parse(json['renewalDate'] as String),
      icon: IconData(
        json['iconCodePoint'] as int,
        fontFamily: json['iconFontFamily'] as String?,
      ),
      color: Color(json['colorValue'] as int),
      billingCycle: BillingCycle.values.firstWhere(
        (e) => e.name == json['billingCycle'],
        orElse: () => BillingCycle.monthly,
      ),
      lastUsedDate: DateTime.parse(json['lastUsedDate'] as String),
    );
  }
}

